{
  "name": "dsh-tool-search",
  "version": "0.1.0",
  "description": "Vendor-style deferred tool loading for DeepSeek Harness: names and purposes resident, schemas on demand, direct calls after discovery",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "tools",
    "deferred-loading",
    "token-optimization"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@types/node": "^22.19.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2"
  }
}
